rca:D-01-3 a aegis:SubDomain ;
    aegis:subDomainId "D-01.3" ;
    rdfs:label "Cryptographic Key Management"@en ;
    aegis:partOf rca:D-01 .

rca:D-01-4 a aegis:SubDomain ;
    aegis:subDomainId "D-01.4" ;
    rdfs:label "Data Integrity Mechanisms"@en ;
    aegis:partOf rca:D-01 .

# D-02

rca:D-02-1 a aegis:SubDomain ;
    aegis:subDomainId "D-02.1" ;
    rdfs:label "Vulnerability Identification"@en ;
    aegis:partOf rca:D-02 .

rca:D-02-2 a aegis:SubDomain ;
    aegis:subDomainId "D-02.2" ;
    rdfs:label "Patch Management and Updates"@en ;
    aegis:partOf rca:D-02 .

rca:D-02-3 a aegis:SubDomain ;
    aegis:subDomainId "D-02.3" ;
    rdfs:label "Coordinated Vulnerability Disclosure"@en ;
    aegis:partOf rca:D-02 .

rca:D-02-4 a aegis:SubDomain ;
    aegis:subDomainId "D-02.4" ;
    rdfs:label "Threat-Led Penetration Testing"@en ;
    aegis:partOf rca:D-02 .

# D-03

rca:D-03-1 a aegis:SubDomain ;
    aegis:subDomainId "D-03.1" ;
    rdfs:label "Identity Lifecycle Management"@en ;
    aegis:partOf rca:D-03 .

rca:D-03-2 a aegis:SubDomain ;
    aegis:subDomainId "D-03.2" ;
    rdfs:label "Multi-Factor Authentication"@en ;
    aegis:partOf rca:D-03 .

rca:D-03-3 a aegis:SubDomain ;
    aegis:subDomainId "D-03.3" ;
    rdfs:label "Authorization and Least Privilege"@en ;
    aegis:partOf rca:D-03 .

rca:D-03-4 a aegis:SubDomain ;
    aegis:subDomainId "D-03.4" ;
    rdfs:label "Secure System Defaults"@en ;
    aegis:partOf rca:D-03 .

