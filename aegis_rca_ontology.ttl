# ============================================================
# SECTION 19 — STRATEGIC TENSIONS
# ============================================================
# Source: 06_Clause_Mapping_Matrix.ods / COMPLEMENTARITY_ANALYSIS (tensions block)
# tensionScope: STRUCTURAL = permanent design constraint | CONTEXTUAL = compound event dependent

rca:T-001 a aegis:StrategicTension ;
    aegis:tensionId "T-001" ;
    aegis:tensionType "TIMING_MISMATCH" ;
    aegis:tensionScope "CONTEXTUAL" ;
    aegis:severity "CRITICAL" ;
    aegis:resolutionPattern "Max-SLA Routing — adopt the strictest deadline (24h) as the unified workflow trigger; satisfies all regulations simultaneously" ;
    aegis:description "Notification timing conflict on D-04.3: GDPR requires 72h (Art. 33), NIS 2 requires 24h early warning (Art. 23(1)), CRA requires 24h (Art. 14(1)), DORA requires 24h (Art. 17(3)). Tension is CONTEXTUAL: only materialises when a single incident simultaneously triggers personal data breach (GDPR), exploited vulnerability (CRA), significant incident (NIS 2), and major ICT incident (DORA)."@en ;
    aegis:affectsSubDomain rca:D-04-3 ;
    aegis:involvesRegulation rca:GDPR , rca:CRA , rca:NIS2 , rca:DORA ;
    aegis:involvesClauses rca:GDPR-C21 , rca:CRA-C25 , rca:NIS2-C25 , rca:DORA-C35 .

rca:T-002 a aegis:StrategicTension ;
    aegis:tensionId "T-002" ;
    aegis:tensionType "RETENTION_CONFLICT" ;
    aegis:tensionScope "STRUCTURAL" ;
    aegis:severity "CRITICAL" ;
    aegis:resolutionPattern "Cryptographic Sharding — retain anonymised/pseudonymised log records; erase the personal data binding key on erasure request; satisfies both obligations structurally" ;
    aegis:description "Retention conflict between GDPR right to erasure (D-05.3, Art. 17) and AI Act mandatory log retention of ≥6 months (D-10.2, Art. 19). STRUCTURAL because both obligations apply permanently whenever an AI system processes personal data: erasure requests are ongoing, log retention is continuous. Cannot be resolved per-event."@en ;
    aegis:affectsSubDomain rca:D-05-3 ;
    aegis:involvesRegulation rca:GDPR , rca:AIAct ;
    aegis:involvesClauses rca:GDPR-C06 , rca:AIA-C19 .

rca:T-003 a aegis:StrategicTension ;
    aegis:tensionId "T-003" ;
    aegis:tensionType "TRIGGER_MISMATCH" ;
    aegis:tensionScope "CONTEXTUAL" ;
    aegis:severity "MEDIUM" ;
    aegis:resolutionPattern "Unified Assessment — produce a single document that meets both DPIA (GDPR Art. 35) and FRIA (AI Act Art. 9/22) requirements with dual signoff; reduces assessment overhead while satisfying both triggers" ;
    aegis:description "Assessment trigger mismatch on D-09.2: GDPR DPIA is ONE_TIME per processing activity (Art. 35), AI Act risk management is CONTINUOUS throughout lifecycle (Art. 9(1)). Tension is CONTEXTUAL: only materialises for AI systems processing personal data where both triggers activate. Methodologically manageable via unified assessment."@en ;
    aegis:affectsSubDomain rca:D-09-2 ;
    aegis:involvesRegulation rca:GDPR , rca:AIAct ;
    aegis:involvesClauses rca:GDPR-C24 , rca:AIA-C01 , rca:AIA-C02 .

rca:T-004 a aegis:StrategicTension ;
    aegis:tensionId "T-004" ;
    aegis:tensionType "ALIGNMENT_OPPORTUNITY" ;
    aegis:tensionScope "CONTEXTUAL" ;
    aegis:severity "LOW" ;
    aegis:resolutionPattern "Unified 24h workflow — NIS 2 and DORA both require 24h notification; a single process satisfies both; the tension is an opportunity for process consolidation rather than conflict" ;
    aegis:description "NIS 2 (Art. 23(1)) and DORA (Art. 17(3)) both require 24h notification for significant incidents. For entities subject to both (financial entities in essential sectors), this is an alignment opportunity: the identical deadline means a single 24h process satisfies both obligations. Classified as ALIGNMENT_OPPORTUNITY, not a conflict."@en ;
    aegis:affectsSubDomain rca:D-04-3 ;
    aegis:involvesRegulation rca:NIS2 , rca:DORA ;
    aegis:involvesClauses rca:NIS2-C25 , rca:DORA-C35 .


