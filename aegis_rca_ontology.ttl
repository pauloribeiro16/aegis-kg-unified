# jaccardIndex = |D(Ra) ∩ D(Rb)| / |D(Ra) ∪ D(Rb)|  (Ferreira 2016, adapted)

rca:CP-GDPR-CRA a aegis:ComplementarityPair ;
    aegis:comparesRegulationA rca:GDPR ;
    aegis:comparesRegulationB rca:CRA ;
    aegis:intersectionCount 11 ;
    aegis:unionCount 31 ;
    aegis:jaccardIndex 0.355 ;
    aegis:complementarityIndex 0.645 ;
