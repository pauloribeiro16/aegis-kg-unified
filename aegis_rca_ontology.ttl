# ============================================================
# SECTION 17 — APPLICABILITY CONDITIONS (per Regulation)
# ============================================================
# Source: 06_Clause_Mapping_Matrix.ods / APPLICABILITY_CONDITIONS sheet
# These conditions are generic (company-agnostic).
# A company context instantiates them with observed values.

rca:AC-GDPR-1 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "processes_personal_data" ;
    aegis:threshold "ANY — at least one personal data attribute processed" ;
    aegis:description "Applies if the entity processes personal data of EU residents in any capacity."@en .

rca:AC-GDPR-2 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "eu_data_subjects" ;
    aegis:threshold "ANY — at least one EU resident as data subject" ;
    aegis:description "Applies if data subjects are located in the EU regardless of where the controller is established."@en .

rca:AC-GDPR-3 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "large_scale_processing" ;
    aegis:threshold "TRUE — high volume or special category data" ;
    aegis:description "DPIA mandatory if large-scale processing of special categories or systematic monitoring."@en .

rca:AC-CRA-1 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "places_digital_products_eu" ;
    aegis:threshold "TRUE — places products with digital elements on EU market" ;
    aegis:description "Applies to any manufacturer placing a product with digital elements on the EU market."@en .

rca:AC-CRA-2 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "product_class" ;
    aegis:threshold "Standard | Important | Critical — per CRA Annex III/IV" ;
    aegis:description "Product classification determines whether self-declaration or third-party audit is required."@en .

rca:AC-NIS2-1 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "nis2_sector" ;
    aegis:threshold "Annex I (Essential) or Annex II (Important) sector" ;
    aegis:description "Applies to entities operating in sectors listed in NIS 2 Annexes I or II."@en .

rca:AC-NIS2-2 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "size_employees" ;
    aegis:threshold "≥50 employees (medium) OR ≥250 employees (large)" ;
    aegis:description "Size threshold: medium entities (≥50 emp.) are Important; large (≥250 emp.) may be Essential."@en .

rca:AC-NIS2-3 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "size_revenue" ;
    aegis:threshold "≥€10M annual turnover (medium) OR ≥€50M (large)" ;
    aegis:description "Revenue threshold used in conjunction with employee count for entity classification."@en .

rca:AC-DORA-1 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "dora_financial_entity" ;
    aegis:threshold "TRUE — credit institution, investment firm, insurer, etc. per DORA Art. 2" ;
    aegis:description "Applies exclusively to financial entities regulated under DORA Art. 2 definitions."@en .

rca:AC-DORA-2 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "financial_sector" ;
    aegis:threshold "Banking | Insurance | Investment | Payment | Crypto per Art. 2" ;
    aegis:description "Specific financial sector determines applicable DORA obligations and supervisory authority."@en .

rca:AC-AIACT-1 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "aiact_high_risk_system" ;
    aegis:threshold "TRUE — AI system listed in Annex III high-risk categories" ;
    aegis:description "Applies to providers and deployers of high-risk AI systems per AI Act Annex III."@en .

rca:AC-AIACT-2 a aegis:ApplicabilityCondition ;
    aegis:applicabilityField "gpai_systemic_risk" ;
    aegis:threshold "TRUE — GPAI model with systemic risk per Art. 51" ;
    aegis:description "Additional obligations (Art. 55) apply to GPAI models designated as systemic risk."@en .

# Link conditions to regulations
rca:GDPR aegis:hasApplicabilityCondition rca:AC-GDPR-1 , rca:AC-GDPR-2 , rca:AC-GDPR-3 .
rca:CRA  aegis:hasApplicabilityCondition rca:AC-CRA-1  , rca:AC-CRA-2 .
rca:NIS2 aegis:hasApplicabilityCondition rca:AC-NIS2-1 , rca:AC-NIS2-2 , rca:AC-NIS2-3 .
rca:DORA aegis:hasApplicabilityCondition rca:AC-DORA-1 , rca:AC-DORA-2 .
rca:AIAct aegis:hasApplicabilityCondition rca:AC-AIACT-1 , rca:AC-AIACT-2 .


