@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix aegis: <https://aegis.arm-methodology.eu/ontology#> .
@prefix rca:   <https://aegis.arm-methodology.eu/rca#> .

# ============================================================
# ONTOLOGY DECLARATION
# ============================================================

<https://aegis.arm-methodology.eu/ontology>
    a owl:Ontology ;
    rdfs:label "AEGIS Regulatory Complementarity Analysis Ontology"@en ;
    rdfs:comment """
        Ontology for the Regulatory Complementarity Analysis sub-module of the 
        ARM (Adaptive Risk Management) Methodology.
        
        v2.0 additions (merged from 06_Clause_Mapping_Matrix.ods):
        - New data properties on aegis:Clause: justification, relevance, companyContextRef
        - New class aegis:ApplicabilityCondition: formal applicability criteria per regulation
        - New class aegis:ComplementarityPair: pairwise Jaccard metrics for all 10 regulation pairs
        - New class aegis:StrategicTension: typed conflicts with severity and resolution patterns
        - New class aegis:SubDomainMetrics: pre-computed NI aggregates per sub-domain
        - New named individual rca:Relevance values (HIGH, MEDIUM, LOW)
        
        Captures five EU cybersecurity regulations (GDPR, CRA, NIS 2, DORA, AI Act),
        decomposed into 150 atomic normative clauses, mapped onto a common taxonomy
        of 10 Security Control Domains and 38 Sub-Domains.
        
        Adapted from: Ferreira, A.L. (2016). Doctoral Thesis, University of Minho.
        ARM Methodology: Ribeiro, P. (in progress). Doctoral Thesis, University of Minho.
    """@en ;
    owl:versionInfo "2.0.0" .


# ============================================================
# SECTION 1 — CLASSES
# ============================================================

# --- Core taxonomy ---

aegis:Domain a owl:Class ;
    rdfs:label "Security Control Domain"@en ;
    rdfs:comment "Top-level grouping of security control concerns (D-01 through D-10)."@en .

aegis:SubDomain a owl:Class ;
    rdfs:label "Security Control Sub-Domain"@en ;
    rdfs:comment "Atomic implementable control area within a Domain (38 total)."@en .

# --- Regulatory entities ---

aegis:Regulation a owl:Class ;
    rdfs:label "Regulation"@en ;
    rdfs:comment "A European Union legal instrument imposing binding cybersecurity obligations."@en .

aegis:Clause a owl:Class ;
    rdfs:label "Regulatory Clause"@en ;
    rdfs:comment """Atomic normative statement extracted from a Regulation, satisfying the 
    ARM atomicity criteria (single sub-domain, single obligationType, single obligatedParty)."""@en .

# --- Obligation value types ---

aegis:ObligationType a owl:Class ;
    rdfs:label "Obligation Type"@en ;
    rdfs:comment "Temporal activation pattern of a normative obligation."@en .

aegis:ObligatedParty a owl:Class ;
    rdfs:label "Obligated Party"@en ;
    rdfs:comment "Legal actor upon whom a clause imposes a direct obligation."@en .

aegis:NormativeStrength a owl:Class ;
    rdfs:label "Normative Strength"@en ;
    rdfs:comment "Categorical weight of the normative language (Weight 1/2/3 from Matrix B2)."@en .

aegis:Relevance a owl:Class ;
    rdfs:label "Relevance"@en ;
    rdfs:comment "Contextual relevance of a clause for a given company profile (HIGH / MEDIUM / LOW)."@en .

aegis:ApplicabilityCondition a owl:Class ;
    rdfs:label "Applicability Condition"@en ;
    rdfs:comment """Formal criterion determining whether a Regulation applies to a given company context.
    Captures the field name, threshold, and observed value from the Company Context Assessment (Phase 1, Step A)."""@en .

aegis:ComplementarityPair a owl:Class ;
    rdfs:label "Complementarity Pair"@en ;
    rdfs:comment """Pairwise complementarity analysis between two Regulations.
    Stores the Jaccard Shared Scope (M1), intersection and union sub-domain counts, and qualitative interpretation.
    Adapted from Ferreira (2016), metric M1."""@en .

aegis:StrategicTension a owl:Class ;
    rdfs:label "Strategic Tension"@en ;
    rdfs:comment """A identified conflict or misalignment between obligations from two or more Regulations
    on the same Sub-Domain. May be Structural (permanent, design-level) or Contextual (conditional on 
    a compound event simultaneously triggering multiple regulatory triggers)."""@en .

aegis:SubDomainMetrics a owl:Class ;
    rdfs:label "Sub-Domain Metrics"@en ;
    rdfs:comment "Pre-computed normative intensity aggregates for a Sub-Domain across all applicable regulations."@en .


# ============================================================
# SECTION 2 — OBJECT PROPERTIES
# ============================================================

aegis:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:domain aegis:Domain ;
    rdfs:range aegis:SubDomain ;
    rdfs:comment "A Domain contains one or more Sub-Domains."@en .

aegis:partOf a owl:ObjectProperty ;
    owl:inverseOf aegis:hasPart ;
    rdfs:label "part of"@en ;
    rdfs:domain aegis:SubDomain ;
    rdfs:range aegis:Domain .

aegis:hasClauses a owl:ObjectProperty ;
    rdfs:label "has clauses"@en ;
    rdfs:domain aegis:Regulation ;
    rdfs:range aegis:Clause ;
    rdfs:comment "A Regulation decomposes into one or more atomic Clauses."@en .

aegis:clauseOf a owl:ObjectProperty ;
    owl:inverseOf aegis:hasClauses ;
    rdfs:label "clause of"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range aegis:Regulation .

aegis:mappedTo a owl:ObjectProperty ;
    rdfs:label "mapped to"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range aegis:SubDomain ;
    rdfs:comment "A Clause is mapped to exactly one Sub-Domain (atomicity constraint)."@en .

aegis:covers a owl:ObjectProperty ;
    rdfs:label "covers"@en ;
    rdfs:domain aegis:Regulation ;
    rdfs:range aegis:SubDomain ;
    rdfs:comment "A Regulation covers a Sub-Domain if it has at least one Clause mapped to it."@en .

aegis:hasObligationType a owl:ObjectProperty ;
    rdfs:label "has obligation type"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range aegis:ObligationType .

aegis:hasObligatedParty a owl:ObjectProperty ;
    rdfs:label "has obligated party"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range aegis:ObligatedParty .

aegis:hasNormativeStrength a owl:ObjectProperty ;
    rdfs:label "has normative strength"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range aegis:NormativeStrength .

rca:hasTensionWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "has tension with"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range aegis:Clause ;
    rdfs:comment "Two Clauses in different Regulations that impose conflicting obligations on the same Sub-Domain."@en .

aegis:hasRelevance a owl:ObjectProperty ;
    rdfs:label "has relevance"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range aegis:Relevance ;
    rdfs:comment "Contextual relevance level of a clause for a given company profile."@en .

aegis:hasApplicabilityCondition a owl:ObjectProperty ;
    rdfs:label "has applicability condition"@en ;
    rdfs:domain aegis:Regulation ;
    rdfs:range aegis:ApplicabilityCondition ;
    rdfs:comment "Links a Regulation to the formal conditions that determine its applicability."@en .

aegis:comparesRegulationA a owl:ObjectProperty ;
    rdfs:label "compares regulation A"@en ;
    rdfs:domain aegis:ComplementarityPair ;
    rdfs:range aegis:Regulation .

aegis:comparesRegulationB a owl:ObjectProperty ;
    rdfs:label "compares regulation B"@en ;
    rdfs:domain aegis:ComplementarityPair ;
    rdfs:range aegis:Regulation .

aegis:involvesRegulation a owl:ObjectProperty ;
    rdfs:label "involves regulation"@en ;
    rdfs:domain aegis:StrategicTension ;
    rdfs:range aegis:Regulation .

aegis:affectsSubDomain a owl:ObjectProperty ;
    rdfs:label "affects sub-domain"@en ;
    rdfs:domain aegis:StrategicTension ;
    rdfs:range aegis:SubDomain .

aegis:involvesClauses a owl:ObjectProperty ;
    rdfs:label "involves clauses"@en ;
    rdfs:domain aegis:StrategicTension ;
    rdfs:range aegis:Clause .

aegis:hasMetrics a owl:ObjectProperty ;
    rdfs:label "has metrics"@en ;
    rdfs:domain aegis:SubDomain ;
    rdfs:range aegis:SubDomainMetrics .


# ============================================================
# SECTION 3 — DATA PROPERTIES
# ============================================================

aegis:domainId a owl:DatatypeProperty ;
    rdfs:label "domain ID"@en ;
    rdfs:domain aegis:Domain ;
    rdfs:range xsd:string .

aegis:subDomainId a owl:DatatypeProperty ;
    rdfs:label "sub-domain ID"@en ;
    rdfs:domain aegis:SubDomain ;
    rdfs:range xsd:string .

aegis:clauseId a owl:DatatypeProperty ;
    rdfs:label "clause ID"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range xsd:string .

aegis:articleReference a owl:DatatypeProperty ;
    rdfs:label "article reference"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range xsd:string .

aegis:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:range xsd:string .

aegis:regulationId a owl:DatatypeProperty ;
    rdfs:label "regulation ID"@en ;
    rdfs:domain aegis:Regulation ;
    rdfs:range xsd:string .

aegis:euReference a owl:DatatypeProperty ;
    rdfs:label "EU official reference"@en ;
    rdfs:domain aegis:Regulation ;
    rdfs:range xsd:string .

# --- New data properties (v2.0) ---

aegis:justification a owl:DatatypeProperty ;
    rdfs:label "justification"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range xsd:string ;
    rdfs:comment "Short rationale explaining why this clause is relevant in the given company context."@en .

aegis:companyContextRef a owl:DatatypeProperty ;
    rdfs:label "company context reference"@en ;
    rdfs:domain aegis:Clause ;
    rdfs:range xsd:string ;
    rdfs:comment "Reference to the Company Context Assessment question (Qnn) that activates this clause."@en .

aegis:applicabilityField a owl:DatatypeProperty ;
    rdfs:label "applicability field"@en ;
    rdfs:domain aegis:ApplicabilityCondition ;
    rdfs:range xsd:string ;
    rdfs:comment "The company context field evaluated (e.g. 'processes_personal_data', 'size_employees')."@en .

aegis:threshold a owl:DatatypeProperty ;
    rdfs:label "threshold"@en ;
    rdfs:domain aegis:ApplicabilityCondition ;
    rdfs:range xsd:string ;
    rdfs:comment "The threshold or criterion that must be met for the regulation to apply."@en .

aegis:conditionMet a owl:DatatypeProperty ;
    rdfs:label "condition met"@en ;
    rdfs:domain aegis:ApplicabilityCondition ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether this applicability condition is satisfied in the assessed company context."@en .

aegis:applicabilityStatus a owl:DatatypeProperty ;
    rdfs:label "applicability status"@en ;
    rdfs:domain aegis:ApplicabilityCondition ;
    rdfs:range xsd:string ;
    rdfs:comment "Outcome: APPLICABLE or NOT_APPLICABLE."@en .

aegis:jaccardIndex a owl:DatatypeProperty ;
    rdfs:label "Jaccard index"@en ;
    rdfs:domain aegis:ComplementarityPair ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Shared Scope (M1): |D(Ra) ∩ D(Rb)| / |D(Ra) ∪ D(Rb)|. Adapted from Ferreira (2016)."@en .

aegis:intersectionCount a owl:DatatypeProperty ;
    rdfs:label "intersection count"@en ;
    rdfs:domain aegis:ComplementarityPair ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of sub-domains covered by both regulations."@en .

aegis:unionCount a owl:DatatypeProperty ;
    rdfs:label "union count"@en ;
    rdfs:domain aegis:ComplementarityPair ;
    rdfs:range xsd:integer ;
    rdfs:comment "Number of sub-domains covered by at least one of the two regulations."@en .

aegis:complementarityIndex a owl:DatatypeProperty ;
    rdfs:label "complementarity index"@en ;
    rdfs:domain aegis:ComplementarityPair ;
    rdfs:range xsd:decimal ;
    rdfs:comment "1 - jaccardIndex. Higher values indicate more complementary (non-overlapping) scope."@en .

aegis:pairInterpretation a owl:DatatypeProperty ;
    rdfs:label "pair interpretation"@en ;
    rdfs:domain aegis:ComplementarityPair ;
    rdfs:range xsd:string .

aegis:tensionId a owl:DatatypeProperty ;
    rdfs:label "tension ID"@en ;
    rdfs:domain aegis:StrategicTension ;
    rdfs:range xsd:string .

aegis:tensionType a owl:DatatypeProperty ;
    rdfs:label "tension type"@en ;
    rdfs:domain aegis:StrategicTension ;
    rdfs:range xsd:string ;
    rdfs:comment "Type: TIMING_MISMATCH | RETENTION_CONFLICT | TRIGGER_MISMATCH | ALIGNMENT_OPPORTUNITY."@en .

aegis:tensionScope a owl:DatatypeProperty ;
    rdfs:label "tension scope"@en ;
    rdfs:domain aegis:StrategicTension ;
    rdfs:range xsd:string ;
    rdfs:comment "STRUCTURAL (permanent, design-level) or CONTEXTUAL (conditional on compound event)."@en .

aegis:severity a owl:DatatypeProperty ;
    rdfs:label "severity"@en ;
    rdfs:domain aegis:StrategicTension ;
    rdfs:range xsd:string ;
    rdfs:comment "CRITICAL | HIGH | MEDIUM | LOW."@en .

aegis:resolutionPattern a owl:DatatypeProperty ;
    rdfs:label "resolution pattern"@en ;
    rdfs:domain aegis:StrategicTension ;
    rdfs:range xsd:string ;
    rdfs:comment "Architectural pattern that resolves the tension (e.g. Max-SLA Routing, Cryptographic Sharding)."@en .

aegis:maxNI a owl:DatatypeProperty ;
    rdfs:label "max normative intensity"@en ;
    rdfs:domain aegis:SubDomainMetrics ;
    rdfs:range xsd:decimal .

aegis:minNI a owl:DatatypeProperty ;
    rdfs:label "min normative intensity"@en ;
    rdfs:domain aegis:SubDomainMetrics ;
    rdfs:range xsd:decimal .

aegis:avgNI a owl:DatatypeProperty ;
    rdfs:label "average normative intensity"@en ;
    rdfs:domain aegis:SubDomainMetrics ;
    rdfs:range xsd:decimal .

aegis:dominantObligationType a owl:DatatypeProperty ;
    rdfs:label "dominant obligation type"@en ;
    rdfs:domain aegis:SubDomainMetrics ;
    rdfs:range xsd:string .

aegis:totalClauseCount a owl:DatatypeProperty ;
    rdfs:label "total clause count"@en ;
    rdfs:domain aegis:SubDomainMetrics ;
    rdfs:range xsd:integer .


# ============================================================
# SECTION 4 — NAMED INDIVIDUALS: ObligationType
# ============================================================

rca:CONTINUOUS a aegis:ObligationType ;
    rdfs:label "Continuous"@en ;
    rdfs:comment "Obligation persists throughout the entire operational period."@en .

rca:TRIGGERED a aegis:ObligationType ;
    rdfs:label "Triggered"@en ;
    rdfs:comment "Obligation activates upon occurrence of a specific event (e.g. breach, request)."@en .

rca:ONE_TIME a aegis:ObligationType ;
    rdfs:label "One-time"@en ;
    rdfs:comment "Obligation must be fulfilled once, typically prior to market placement or processing start."@en .

rca:PERIODIC a aegis:ObligationType ;
    rdfs:label "Periodic"@en ;
    rdfs:comment "Obligation recurs at defined intervals (annually, regularly, as scheduled)."@en .


# ============================================================
# SECTION 5 — NAMED INDIVIDUALS: ObligatedParty
# ============================================================

rca:CONTROLLER a aegis:ObligatedParty ;
    rdfs:label "Controller"@en ;
    rdfs:comment "GDPR data controller: entity that determines purposes and means of personal data processing."@en .

rca:MANUFACTURER a aegis:ObligatedParty ;
    rdfs:label "Manufacturer"@en ;
    rdfs:comment "CRA manufacturer: entity that designs, develops and places products with digital elements on the EU market."@en .

rca:ESSENTIAL_OR_IMPORTANT_ENTITY a aegis:ObligatedParty ;
    rdfs:label "Essential or Important Entity"@en ;
    rdfs:comment "NIS 2 entity: organisation classified as essential or important under Art. 3 of NIS 2 Directive."@en .

rca:FINANCIAL_ENTITY a aegis:ObligatedParty ;
    rdfs:label "Financial Entity"@en ;
    rdfs:comment "DORA financial entity: credit institution, insurance undertaking, investment firm and other entities per Art. 2 DORA."@en .

rca:PROVIDER a aegis:ObligatedParty ;
    rdfs:label "Provider"@en ;
    rdfs:comment "AI Act provider: entity that develops or has a high-risk AI system developed and places it on the market."@en .

rca:DEPLOYER a aegis:ObligatedParty ;
    rdfs:label "Deployer"@en ;
    rdfs:comment "AI Act deployer: entity that uses a high-risk AI system under its authority."@en .


# ============================================================
# SECTION 6 — NAMED INDIVIDUALS: NormativeStrength
# ============================================================

rca:Weight1 a aegis:NormativeStrength ;
    rdfs:label "Weight 1 — Conditional"@en ;
    rdfs:comment "Conditional language: 'where appropriate', 'if applicable', 'as necessary'. Obligation applies subject to context."@en .

rca:Weight2 a aegis:NormativeStrength ;
    rdfs:label "Weight 2 — Unconditional-Flexible"@en ;
    rdfs:comment "Unconditional but flexible language: 'shall', 'must' without specific technical prescriptions."@en .

rca:Weight3 a aegis:NormativeStrength ;
    rdfs:label "Weight 3 — Unconditional-Specific"@en ;
    rdfs:comment "Unconditional and technically specific: 'shall' with named control (MFA, 72h deadline, SBOM)."@en .


# ============================================================
# SECTION 7 — NAMED INDIVIDUALS: Relevance
# ============================================================

rca:HIGH a aegis:Relevance ;
    rdfs:label "High Relevance"@en ;
    rdfs:comment "Clause is directly and fully applicable to the company context with no conditions."@en .

rca:MEDIUM a aegis:Relevance ;
    rdfs:label "Medium Relevance"@en ;
    rdfs:comment "Clause is applicable but with lower priority or partial scope in the company context."@en .

rca:LOW a aegis:Relevance ;
    rdfs:label "Low Relevance"@en ;
    rdfs:comment "Clause applies only under specific edge-case conditions in the company context."@en .


# ============================================================
# SECTION 8 — NAMED INDIVIDUALS: Regulations
# ============================================================

rca:GDPR a aegis:Regulation ;
    aegis:regulationId "GDPR" ;
    aegis:euReference "Regulation (EU) 2016/679" ;
    rdfs:label "General Data Protection Regulation"@en ;
    aegis:description "EU Regulation on the protection of natural persons with regard to the processing of personal data and the free movement of such data."@en .

rca:CRA a aegis:Regulation ;
    aegis:regulationId "CRA" ;
    aegis:euReference "Regulation (EU) 2024/2847" ;
    rdfs:label "Cyber Resilience Act"@en ;
    aegis:description "EU Regulation on horizontal cybersecurity requirements for products with digital elements."@en .

rca:NIS2 a aegis:Regulation ;
    aegis:regulationId "NIS2" ;
    aegis:euReference "Directive (EU) 2022/2555" ;
    rdfs:label "Network and Information Security Directive 2"@en ;
    aegis:description "EU Directive on measures for a high common level of cybersecurity across the Union."@en .

rca:DORA a aegis:Regulation ;
    aegis:regulationId "DORA" ;
    aegis:euReference "Regulation (EU) 2022/2554" ;
    rdfs:label "Digital Operational Resilience Act"@en ;
    aegis:description "EU Regulation on digital operational resilience for the financial sector."@en .

rca:AIAct a aegis:Regulation ;
    aegis:regulationId "AIAct" ;
    aegis:euReference "Regulation (EU) 2024/1689" ;
    rdfs:label "EU Artificial Intelligence Act"@en ;
    aegis:description "EU Regulation laying down harmonised rules on artificial intelligence."@en .


# ============================================================
# SECTION 8 — NAMED INDIVIDUALS: Domains (D-01 through D-10)
# ============================================================

rca:D-01 a aegis:Domain ;
    aegis:domainId "D-01" ;
    rdfs:label "Cryptography"@en ;
    aegis:description "Data at rest, in transit, key management, and integrity mechanisms."@en .

rca:D-02 a aegis:Domain ;
    aegis:domainId "D-02" ;
    rdfs:label "Vulnerability Management"@en ;
    aegis:description "Identification, patching, coordinated disclosure, and penetration testing."@en .

rca:D-03 a aegis:Domain ;
    aegis:domainId "D-03" ;
    rdfs:label "Access Control"@en ;
    aegis:description "Identity lifecycle, MFA, least privilege, and secure system defaults."@en .

rca:D-04 a aegis:Domain ;
    aegis:domainId "D-04" ;
    rdfs:label "Incident Management"@en ;
    aegis:description "Detection, containment, regulatory notification, and recovery."@en .

rca:D-05 a aegis:Domain ;
    aegis:domainId "D-05" ;
    rdfs:label "Data Lifecycle"@en ;
    aegis:description "Minimization, retention, erasure, and portability."@en .

rca:D-06 a aegis:Domain ;
    aegis:domainId "D-06" ;
    rdfs:label "Supply Chain Security"@en ;
    aegis:description "Vendor assessment, SBOM, contractual obligations, and boundary management."@en .

rca:D-07 a aegis:Domain ;
    aegis:domainId "D-07" ;
    rdfs:label "Secure Development"@en ;
    aegis:description "Secure-by-design, coding practices, CI/CD pipeline security, and change management."@en .

rca:D-08 a aegis:Domain ;
    aegis:domainId "D-08" ;
    rdfs:label "Governance and Awareness"@en ;
    aegis:description "General awareness, role-specific competence, and board-level training."@en .

rca:D-09 a aegis:Domain ;
    aegis:domainId "D-09" ;
    rdfs:label "Risk and Impact Assessment"@en ;
    aegis:description "Policies, assessments, asset inventories, and records of processing."@en .

rca:D-10 a aegis:Domain ;
    aegis:domainId "D-10" ;
    rdfs:label "Monitoring and Audit"@en ;
    aegis:description "Continuous monitoring, audit logging, and compliance testing."@en .


# ============================================================
# SECTION 9 — NAMED INDIVIDUALS: Sub-Domains (38 total)
# ============================================================

# D-01

rca:D-01-1 a aegis:SubDomain ;
    aegis:subDomainId "D-01.1" ;
    rdfs:label "Data at Rest Encryption"@en ;
